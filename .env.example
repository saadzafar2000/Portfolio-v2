# SMTP credentials for the contact form (app/api/contact/route.ts).
#
# These are the settings for the mailbox that already backs
# contact@muhammadsaadzafar.com — look them up in your mail provider's control
# panel under "SMTP", "Mail client setup", or "IMAP/SMTP access".
#
# Copy this file to .env.local and fill it in. .env.local is gitignored.
# Add the same four variables in Vercel → Settings → Environment Variables.
#
# Common providers:
#   Zoho Mail        smtp.zoho.eu        465
#   Google Workspace smtp.gmail.com      465   (requires an App Password)
#   Namecheap PE     mail.privateemail.com 465
#   Microsoft 365    smtp.office365.com  587
#
# Use an app-specific password where the provider offers one — never your
# account login password.

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contact@muhammadsaadzafar.com
SMTP_PASSWORD=

# Where enquiries land. Optional — defaults to SMTP_USER.
CONTACT_TO=

# Microsoft Clarity project ID (heatmaps + session recordings).
# Optional — defaults to the project ID baked into
# components/layout/clarity.tsx. Set this only to point at a different Clarity
# project. The tag is only loaded when NODE_ENV=production.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
